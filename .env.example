# ===========================================
# AI Support Agent — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- App ---
APP_NAME=AI Support Agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_support_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_support_agent

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_CHARACTERS_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# --- AI Providers ---
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# --- Admin (first launch) ---
ADMIN_EMAIL=admin@company.com
ADMIN_NAME=Admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
